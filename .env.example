# Environment Variables Example
# Copy this file to .env.local and fill in your values.
# In production, set these in the Vercel dashboard. Never commit real values: this repository is public.

# Newsletter feature flag (subscribe, unsubscribe and admin pages return 404 while off)
# NEXT_PUBLIC_FEATURE_NEWSLETTER="true"

# Newsletter database (Neon Postgres, EU region). Schema: db/migrations/0001_newsletter.sql
# DATABASE_URL="postgresql://user:password@host/sugnl?sslmode=require"

# Transactional email via SMTP from a dedicated mailbox (never a personal one)
# SMTP_HOST="smtp.transip.email"
# SMTP_PORT="465"
# SMTP_USER="newsletter@sugnl.net"
# SMTP_PASSWORD="mailbox-password"
# SMTP_FROM="SUGNL <newsletter@sugnl.net>"

# Signs personal unsubscribe links in emails. Rotating it invalidates every link already sent.
# NEWSLETTER_UNSUBSCRIBE_SECRET="generate with: openssl rand -base64 32"

# Admin sign-in (Auth.js with a GitHub OAuth App)
# AUTH_SECRET="generate with: npx auth secret"
# AUTH_GITHUB_ID="github-oauth-app-client-id"
# AUTH_GITHUB_SECRET="github-oauth-app-client-secret"
# Comma-separated GitHub numeric user IDs (see https://api.github.com/users/<username>)
# ADMIN_GITHUB_IDS="1234567"

# Daily cleanup of expired Pending Subscriptions (Vercel Cron sends this as a bearer token)
# CRON_SECRET="random-string"

# Site URL used in emailed links (defaults to https://www.sugnl.net)
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
